# API base URL
NEXT_PUBLIC_API_URL=http://localhost:5000

# Google OAuth client ID (must match server GOOGLE_CLIENT_ID)
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your_google_oauth_client_id_here

# Admin action key (required for sensitive admin operations like delete/revoke)
NEXT_PUBLIC_ADMIN_ACTION_KEY=your_strong_admin_action_key

